# Copy to apps/web/.env — never commit .env

APP_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string

# --- LLM for JD resume tailor (Python agents: groq, openai, or ollama) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OR: OpenAI — https://platform.openai.com/api-keys
# LLM_PROVIDER=openai
# OPENAI_API_KEY=

# Optional: LinkedIn people on company search — https://serpapi.com
SERPAPI_API_KEY=

# Optional: Python agents base URL (default http://127.0.0.1:8000)
# PYTHON_API_URL=http://127.0.0.1:8000
