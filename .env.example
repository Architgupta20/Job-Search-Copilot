# Copy to apps/web/.env — never commit .env

APP_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_search_copilot

# --- LLM for JD resume tailor (pick ONE provider) ---
# Set LLM_PROVIDER to one of: groq | openrouter | ollama | anthropic | gemini | openai

# RECOMMENDED FREE: Groq — https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# OR: OpenRouter (some free models) — https://openrouter.ai/keys
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OR: Ollama — 100% local, no API key — https://ollama.com
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# OR: Anthropic — https://console.anthropic.com/
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# OR: Google Gemini — https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=

# OR: OpenAI — https://platform.openai.com/api-keys
# LLM_PROVIDER=openai
# OPENAI_API_KEY=

# Optional: LinkedIn people on company search — https://serpapi.com
SERPAPI_API_KEY=

# Python agents (FastAPI on port 8000). Next.js proxies when this URL is reachable.
# PYTHON_API_URL=http://127.0.0.1:8000
