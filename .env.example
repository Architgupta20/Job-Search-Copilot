# Copy to apps/web/.env — never commit .env

APP_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string

# --- LLM for JD resume tailor (Python agents: groq, openai, or ollama) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OR: OpenAI — https://platform.openai.com/api-keys
# LLM_PROVIDER=openai
# OPENAI_API_KEY=

# Outreach (email + LinkedIn): uses structured templates by default (best on Ollama 3.2 / free tiers).
# Set OUTREACH_USE_LLM=true to let LLM polish only the company hook sentence.
# OUTREACH_USE_LLM=false

# Company search: LinkedIn people + web/email research — https://serpapi.com
SERPAPI_API_KEY=
# Set true when monthly quota is used up (uses Manual outreach mode in UI)
# SERPAPI_DISABLED=true

# Cache SerpAPI responses on disk (default 7 days) — repeat company searches use fewer API calls
# SERPAPI_CACHE_TTL_HOURS=168
# SERPAPI_CACHE_DISABLED=false

# Email discovery (Hunter.io) — https://hunter.io/api-keys
HUNTER_API_KEY=

# Optional: Python agents base URL (default http://127.0.0.1:8000)
# PYTHON_API_URL=http://127.0.0.1:8000

# Production: comma-separated frontend URLs allowed to call agents (CORS)
# Localhost is always allowed. Set on Railway/Render when you deploy agents.
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app-staging.vercel.app
